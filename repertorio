contactos = {}

while True:
    menu = """
    ### ELIGE UNA OPCION ###

    1. Agregar un contacto.
    2. Buscar un contacto.
    3. Eliminar un contacto.
    4. Ver contactos.
    5. Salir de la aplicacion.
    """

    opcion_elegida = int(input(menu))

    if opcion_elegida == 1:
        nombre = input("Nombre del contacto que quiera ingresar: ").lower()
        telefono = input("Numero de telefono que quiera ingresar: ")
        mail = input("Gmail que quiere ingresar: ")
        direccion = input("Direccion que desea ingresar: ")

        contactos[nombre] = {
            "nombre_completo": nombre,
            "telefono": telefono,
            "gmail": mail,
            "direccion": direccion,
        }

        print(f"Contacto {nombre} guardado exitosamente")

    elif opcion_elegida == 2:
        nombre = input("Nombre del contacto que desea buscar: ").lower()

        if nombre in contactos:
            print(f"Nombre: {contactos[nombre]['nombre_completo']}")
            print(f"Telefono: {contactos[nombre]['telefono']}")
            print(f"Gmail: {contactos[nombre]['gmail']}")
            print(f"Direccion: {contactos[nombre]['direccion']}")
        else:
            print("El contacto no existe")

    elif opcion_elegida == 3:
        nombre = input("Nombre del contacto que desea eliminar: ").lower()

        if nombre in contactos:
            contactos.pop(nombre)
            print(f"Contacto {nombre} eliminado exitosamente")
        else:
            print("El contacto no existe")

    elif opcion_elegida == 4:
        for i,key in enumerate(contactos):
            print({i+1},"-", key)
                
            
        else:
            print("No hay contactos registrados")

    elif opcion_elegida == 5:
        print("Saliendo de la aplicacion...")
        break

    else:
        print("Opcion invalida")
